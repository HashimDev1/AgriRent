# AgriRent Environment Configuration
# Copy this to .env (or configure these variables in Render Dashboard)

# Server Port (Render sets this automatically, default 5001 or 5000 for local dev)
PORT=5001

# Node Environment ('production' on Render, 'development' locally)
NODE_ENV=production

# MongoDB Connection String (Atlas URI required for production deployment)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/agrirent?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agrirent?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL (Used for CORS in production if hosted on a separate domain)
# For unified deployment on Render, you can leave this empty or set your Render URL
CLIENT_URL=https://agrirent.onrender.com

# Cloudinary Storage Configuration (Optional, falls back to mock images if omitted)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
